{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check local Git status",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Git remotes",
			"type": "shell",
			"command": "git",
			"args": [
				"remote",
				"-v"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect local and remote branches",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"git status --short --branch; git branch -vv; git log -1 --oneline; git ls-remote --heads origin"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}